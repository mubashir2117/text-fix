# Server-side only — never expose these with a NEXT_PUBLIC_ prefix.
#
# Option A: one key.
GEMINI_API_KEY=

# Option B: ordered failover list (tried in order on transient errors).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=

# Optional model override — defaults to gemini-3.6-flash.
# Confirm the exact model name is available to your key/API version.
GEMINI_MODEL=
# Optional second model tier, only tried if every key fails against GEMINI_MODEL.
GEMINI_MODEL_FALLBACK=
